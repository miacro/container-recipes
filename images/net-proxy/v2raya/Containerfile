# ================= Stage 1: Smart File Fetcher (Local First, Network Fallback) =================
FROM alpine:latest AS downloader

RUN apk add --no-cache curl tar

WORKDIR /download

# Install required tools for logic checks and extraction
RUN apk add --no-cache curl tar unzip bash

WORKDIR /download

# Define robust curl options for network fallback (anti-reset, with retries)
ENV CURL_OPTS="-L --http1.1 --retry 5 --retry-delay 3 --connect-timeout 15"

# Layer 1: geoip.dat
RUN --mount=type=bind,source=.,target=/context \
    if [ -f /context/files/geoip.dat ]; then \
        echo "➤ [Local Cache Hit] Found local geoip.dat, copying directly..."; \
        cp /context/files/geoip.dat ./geoip.dat; \
    else \
        echo "➤ [Network Fallback] No local geoip.dat, downloading..."; \
        curl ${CURL_OPTS} -o geoip.dat https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat; \
    fi

# Layer 2: geosite.dat
RUN --mount=type=bind,source=.,target=/context \
    if [ -f /context/files/geosite.dat ]; then \
        echo "➤ [Local Cache Hit] Found local geosite.dat, copying directly..."; \
        cp /context/files/geosite.dat ./geosite.dat; \
    else \
        echo "➤ [Network Fallback] No local geosite.dat, downloading..."; \
        curl ${CURL_OPTS} -o geosite.dat https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat; \
    fi

# Layer 3: Xray-core
RUN --mount=type=bind,source=.,target=/context \
    if [ -f /context/files/xray ]; then \
        echo "➤ [Local Cache Hit] Found local xray, copying directly..."; \
        cp /context/files/xray ./xray; \
    else \
        echo "➤ [Network Fallback] No local xray, downloading and extracting..."; \
        curl ${CURL_OPTS} -o xray.zip https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip \
        && unzip -j -o xray.zip xray -d . \
        && rm -f xray.zip; \
    fi

# Layer 4: v2rayA (Note the escaped $$ for container-level shell variables)
RUN --mount=type=bind,source=.,target=/context \
    if [ -f /context/files/v2raya ]; then \
        echo "➤ [Local Cache Hit] Found local v2raya, copying directly..."; \
        cp /context/files/v2raya ./v2raya; \
    else \
        echo "➤ [Network Fallback] No local v2raya, downloading..."; \
        V2RAYA_URL=$$(curl -s https://api.github.com/repos/v2rayA/v2rayA/releases/latest | grep "browser_download_url.*v2raya_linux_x64" | head -n 1 | cut -d '"' -f 4) \
        && curl ${CURL_OPTS} -o v2raya $${V2RAYA_URL}; \
    fi

# Layer 5: sing-box
RUN --mount=type=bind,source=.,target=/context \
    if [ -f /context/files/sing-box ]; then \
        echo "➤ [Local Cache Hit] Found local sing-box, copying directly..."; \
        cp /context/files/sing-box ./sing-box; \
    else \
        echo "➤ [Network Fallback] No local sing-box, downloading and extracting..."; \
        SINGBOX_URL=$$(curl -s https://api.github.com/repos/SagerNet/sing-box/releases/latest | grep "browser_download_url.*linux-amd64.tar.gz" | head -n 1 | cut -d '"' -f 4) \
        && curl ${CURL_OPTS} -o sing-box.tar.gz $${SINGBOX_URL} \
        && tar -zxvf sing-box.tar.gz \
        && mv sing-box-*-linux-amd64/sing-box . \
        && rm -rf sing-box-*-linux-amd64 sing-box.tar.gz; \
    fi

# Layer 6: Ensure permissions are set
RUN chmod +x xray v2raya sing-box

# ================= Stage 2: Assemble the Final Lightweight Image =================
FROM alpine:latest

ARG TARGET_TZ=Asia/Shanghai
RUN echo "https://dl-cdn.alpinelinux.org/alpine/edge/main" > /etc/apk/repositories \
    && echo "https://dl-cdn.alpinelinux.org/alpine/edge/community" >> /etc/apk/repositories \
    \
    && apk update \
    && apk add --no-cache \
    ca-certificates \
    iptables \
    ip6tables \
    iproute2 \
    bash \
    tzdata \
    v2ray \
    \
    && cp /usr/share/zoneinfo/${TARGET_TZ} /etc/localtime \
    && echo "${TARGET_TZ}" > /etc/timezone \
    && apk del tzdata

ENV V2RAYA_V2RAY_BIN=/usr/bin/xray
ENV V2RAYA_LOG_DIR=/var/log/v2raya
ENV XRAY_LOCATION_ASSET=/usr/share/xray

COPY --from=downloader /download/xray_dir/xray /usr/bin/xray
COPY --from=downloader /download/v2raya /usr/bin/v2raya
COPY --from=downloader /download/sing-box /usr/bin/sing-box
COPY --from=downloader /download/geoip.dat ${XRAY_LOCATION_ASSET}/geoip.dat
COPY --from=downloader /download/geosite.dat ${XRAY_LOCATION_ASSET}/geosite.dat
COPY --from=downloader /download/geoip.dat /usr/share/v2ray/geoip.dat
COPY --from=downloader /download/geosite.dat /usr/share/v2ray/geosite.dat

RUN mkdir -p ${V2RAYA_LOG_DIR}

EXPOSE 2017

CMD ["v2raya", "--address", "0.0.0.0:2017", "--log-disable-file"]