# ================= Stage 1: Smart File Fetcher (Local First, Network Fallback) =================
FROM alpine:latest AS downloader

# Install required tools for logic checks and extraction
RUN apk add --no-cache curl tar unzip bash wget

WORKDIR /download

# ARG DOWNLOAD="curl -L --http1.1 --retry 5 --retry-delay 3 --connect-timeout 15 -o"
ARG DOWNLOAD="wget -c --tries=100 --retry-connrefused -O"

# 1. Download geoip.dat independently
RUN ${DOWNLOAD} geoip.dat https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat

# 2. Download geosite.dat independently
RUN ${DOWNLOAD} geosite.dat https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat

# 3. Download Xray-core (Dynamic mapping for 64 vs arm64-v8a)
RUN if [ "$TARGETARCH" = "arm64" ]; then ARCH="arm64-v8a"; else ARCH="64"; fi \
    && ${DOWNLOAD} xray.zip "https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-${ARCH}.zip" \
    && unzip -j -o xray.zip xray -d . \
    && rm -f xray.zip

# 4. Download v2rayA (Dynamic mapping for x64 vs arm64)
RUN if [ "$TARGETARCH" = "arm64" ]; then ARCH="arm64"; else ARCH="x64"; fi \
    && V2RAYA_URL=$(curl -s https://api.github.com/repos/v2rayA/v2rayA/releases/latest | grep "browser_download_url.*v2raya_linux_${ARCH}" | head -n 1 | cut -d '"' -f 4) \
    && ${DOWNLOAD} v2raya "$V2RAYA_URL"

# 5. Download sing-box (Dynamic mapping for amd64 vs arm64)
RUN if [ "$TARGETARCH" = "arm64" ]; then ARCH="arm64"; else ARCH="amd64"; fi \
    && SINGBOX_URL=$(curl -s https://api.github.com/repos/SagerNet/sing-box/releases/latest | grep "browser_download_url.*linux-${ARCH}.tar.gz" | head -n 1 | cut -d '"' -f 4) \
    && ${DOWNLOAD} sing-box.tar.gz "$SINGBOX_URL" \
    && tar -zxvf sing-box.tar.gz \
    && mv sing-box-*-linux-${ARCH}/sing-box . \
    && rm -rf sing-box-*-linux-${ARCH} sing-box.tar.gz

# Grant execution permissions
RUN chmod +x xray v2raya sing-box

# ================= Stage 2: Assemble the Final Lightweight Image =================
FROM alpine:latest

ARG TARGET_TZ=Asia/Shanghai
RUN echo "https://dl-cdn.alpinelinux.org/alpine/edge/main" > /etc/apk/repositories \
    && echo "https://dl-cdn.alpinelinux.org/alpine/edge/community" >> /etc/apk/repositories \
    \
    && apk update \
    && apk add --no-cache \
    ca-certificates \
    iptables \
    ip6tables \
    iproute2 \
    bash \
    tzdata \
    v2ray \
    \
    && cp /usr/share/zoneinfo/${TARGET_TZ} /etc/localtime \
    && echo "${TARGET_TZ}" > /etc/timezone \
    && apk del tzdata

ENV V2RAYA_V2RAY_BIN=/usr/bin/xray
ENV V2RAYA_LOG_DIR=/var/log/v2raya
ENV XRAY_LOCATION_ASSET=/usr/share/xray

RUN mkdir -p ${V2RAYA_LOG_DIR} ${XRAY_LOCATION_ASSET} /usr/share/v2ray

# Copy perfectly cached files directly from the first stage
COPY --from=downloader /download/xray /usr/bin/xray
COPY --from=downloader /download/v2raya /usr/bin/v2raya
COPY --from=downloader /download/sing-box /usr/bin/sing-box
COPY --from=downloader /download/geoip.dat ${XRAY_LOCATION_ASSET}/geoip.dat
COPY --from=downloader /download/geosite.dat ${XRAY_LOCATION_ASSET}/geosite.dat

# Copy rule files to default v2ray directory to prevent compatibility issues
RUN cp ${XRAY_LOCATION_ASSET}/geoip.dat /usr/share/v2ray/geoip.dat \
    && cp ${XRAY_LOCATION_ASSET}/geosite.dat /usr/share/v2ray/geosite.dat

EXPOSE 2017
ENV V2RAYA_LOG_FILE=/var/log/v2raya/v2raya.log
# ENV V2RAYA_LOG_CONSOLE=true

CMD ["v2raya", "--address", "0.0.0.0:2017"]